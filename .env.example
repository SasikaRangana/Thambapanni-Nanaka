# App Settings
PROJECT_NAME="Thambapanni Nanaka API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated origins for Next.js frontend)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://thambapanni-nanaka.vercel.app"

# Supabase Credentials (PostgreSQL + Realtime)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Cloudinary Credentials (Image Uploads)
# Found in: Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# OR specify the full URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Admin Authentication Token (Secret used by admin dashboard to perform CRUD & uploads)
ADMIN_SECRET="thambapanni_super_secret_admin_token_2025"

# WhatsApp Direct Inquiries Settings
WHATSAPP_PHONE_NUMBER="94771234567"
DEFAULT_CURRENCY_SYMBOL="LKR"
